# Address your browser uses to download the finished files (server IP or domain + port).
PUBLIC_URL=http://YOUR-SERVER-IP:8010
# Port published on the server.
DECK_BUILDER_PORT=8010
# Shared secret; put the same value in the Open WebUI tool's API_KEY valve. Leave empty to disable.
API_KEY=change-me
# Docker network of your Open WebUI container (`docker network ls` to find it).
OPENWEBUI_NETWORK=open-webui_default
# Days to keep generated files.
KEEP_DAYS=14
